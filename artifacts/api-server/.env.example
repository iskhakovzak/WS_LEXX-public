# WS_LEXX API server — every environment variable it reads (parsed by src/config.ts; nothing else reads process.env).
# Copy the ones you need into the repo-root .env.local (development) or Replit Secrets (production). Never commit values.
# "required (prod)" = the server refuses to start in production without it (one clear error listing every problem).

# ── runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development              # development | production | test
PORT=8080                         # required: HTTP port
LOG_LEVEL=info                    # pino level: fatal error warn info debug trace

# ── database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edge_tracker   # required (read by lib/db). LOCAL ONLY in development
PGDATABASE=                       # optional: database name shown in admin exports
PG_STATEMENT_TIMEOUT_MS=30000     # pool statement_timeout per query (migrations/jobs raise it locally)
PG_POOL_MAX=10                    # pool size
PG_APPLICATION_NAME=ws-lexx-api   # optional: pg_stat_activity application_name (lib/db)

# ── auth & secrets (owner rotates them; never derive one from another in production) ──
JWT_SECRET=                       # required: signs session tokens
MEDIA_TOKEN_SECRET=               # required (prod): HMAC for 5-minute voice-note URLs. Dev: derived from JWT_SECRET with a warning
TELEGRAM_WEBHOOK_SECRET=          # required (prod): X-Telegram-Bot-Api-Secret-Token. Dev: derived from JWT_SECRET with a warning
ADMIN_PASSWORD=                   # optional: enables POST /api/auth/init-passwords (disabled when unset)
INIT_PASSWORDS=                   # optional JSON {"Name":"secret"} for init-passwords
PLAYBOOK_PASSWORD=                # optional: confirms deleting a whole playbook folder (endpoint answers 500 when unset)
SEED_USERS=                       # optional JSON [{"name","password","role"}] for an EMPTY users table (dev seeds random PINs otherwise)
GUEST_MODE=                       # on/off; unset → on in development, off in production

# ── HTTP ──────────────────────────────────────────────────────────────────────
REPLIT_DOMAINS=                   # comma-separated allowed origins (development CORS)
TRUST_PROXY=                      # proxy hops for req.ip (lib/security/http.ts)
SITE_URL=https://zakit.website    # absolute links in Telegram messages
RELEASE_SHA=                      # optional: build id for the error tracker (else REPLIT_DEPLOYMENT_ID)
REPLIT_DEPLOYMENT_ID=             # set by Replit deployments

# ── Telegram / email ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=               # bot token; without it nothing is sent
TELEGRAM_BOT_USERNAME=DailyDigest_WS_bot
TELEGRAM_WEBHOOK_URL=             # production only: https://<domain>/api/telegram/webhook (registered at boot)
RESEND_API_KEY=                   # email digests (legacy path)

# ── object storage & backups ─────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID= # Replit Object Storage bucket (backups, voice notes); backups job is disabled without it
PUBLIC_OBJECT_SEARCH_PATHS=       # comma-separated public object paths
PRIVATE_OBJECT_DIR=               # private object dir (voice notes default "objects")
BACKUP_CRON=15 3 * * *            # daily pg_dump -Fc, cron in America/New_York (needs pg_dump ≥ server major version)

# ── background jobs ───────────────────────────────────────────────────────────
JOBS_ENABLED=true                 # false = no scheduler (e.g. a second local API on the same DB); manual runs still work

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_MODEL=claude-sonnet-4-5 # model for playbook AI helpers
AI_DAILY_COST_BUDGET_USD=5.0      # auto AI reviews stop for the day above this spend
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=   # read by lib/integrations-anthropic-ai
AI_INTEGRATIONS_ANTHROPIC_API_KEY=    # read by lib/integrations-anthropic-ai
AI_INTEGRATIONS_OPENAI_BASE_URL=  # transcription (OpenAI-compatible)
AI_INTEGRATIONS_OPENAI_API_KEY=

# ── voice transcription ───────────────────────────────────────────────────────
TRANSCRIBE_PROVIDER=openai        # openai | local
TRANSCRIBE_FALLBACK=              # "off" disables local → openai fallback
WHISPER_URL=http://127.0.0.1:8178 # local whisper server
WHISPER_LANGUAGE=ru
WHISPER_PROMPT=                   # unset = default trading vocabulary prompt; empty = no prompt

# ── PropReports ───────────────────────────────────────────────────────────────
PROPREPORTS_DOMAIN=               # e.g. yourfirm (→ yourfirm.propreports.com)
PROPREPORTS_TOKEN=                # API token, or USER + PASSWORD
PROPREPORTS_USER=
PROPREPORTS_PASSWORD=
PROPREPORTS_GROUP_ID=
PROPREPORTS_ACCOUNT_IDS=          # comma-separated
PROPREPORTS_SYNC_MINUTES=         # ≥ 5 enables the scheduled sync job (propreports.sync)

# ── tools (not read by the server) ────────────────────────────────────────────
SNAPSHOT_DATABASE_URL=            # db:snapshot server (scratch DB created/dropped there; local only)
TEST_DATABASE_URL=                # vitest database (default local edge_tracker)
